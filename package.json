{
  "name": "puneverse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PuneVerse — interactive 3D digital twin of Pune (open data, free hosting)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "deploy": "npm run build && wrangler pages deploy dist --project-name puneverse --commit-dirty=true"
  },
  "dependencies": {
    "maplibre-gl": "^6.17.0",
    "pmtiles": "^4.5.0",
    "posthog-js": "^1.447.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.187.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@maplibre/maplibre-gl-style-spec": "26.6.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.16.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "puppeteer-core": "^25.17.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
