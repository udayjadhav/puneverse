# Optional override for basemap style URL (light mode).
# Default: OpenFreeMap liberty from config/cities/pune.json
# VITE_TILE_URL=https://tiles.openfreemap.org/styles/liberty

# Optional dark basemap override
# VITE_TILE_URL_DARK=https://tiles.openfreemap.org/styles/dark

# --- PostHog Cloud (private product analytics) ---
# Create a project at https://posthog.com — use the *project* API key only
# (phc_…). Never put a personal API key or secret here.
#
# Local: leave disabled (default). To test locally:
#   VITE_ANALYTICS_ENABLED=true
#   VITE_POSTHOG_KEY=phc_your_project_key
#   VITE_POSTHOG_HOST=https://us.i.posthog.com
#
# Production (GitHub Pages): set the same names as repository Actions secrets /
# variables — see docs/ANALYTICS.md.
VITE_ANALYTICS_ENABLED=false
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Live City: optional Cloudflare Worker base URL for shared cache.
# If empty, the app calls Open-Meteo directly (free non-commercial, no key).
# Never put OpenAQ or other secrets in VITE_*. See docs/LIVE_CITY_FREE_DATA.md.
# VITE_LIVE_API_BASE=https://puneverse-live-api.example.workers.dev
VITE_LIVE_API_BASE=
